# Per-instance secrets for destination demo (shared ones are in .kamal/secrets-common).
# Generate the files with: ./new-tenant.sh creates these for customers; for the demo run once:
#   mkdir -p config/secrets/demo && python -c "import secrets; print(secrets.token_urlsafe(50))" > config/secrets/demo/django_secret.key
#   python -c "import secrets; print(secrets.token_urlsafe(12) + '/')" > config/secrets/demo/django_admin_url.key
DJANGO_SECRET_KEY=$(cat config/secrets/demo/django_secret.key)
DJANGO_ADMIN_URL=$(cat config/secrets/demo/django_admin_url.key)
KICOMA_DEMO_SUPERUSER_PASSWORD=$(cat config/secrets/demo/demo_superuser_password.key)
