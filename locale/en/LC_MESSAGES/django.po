#: kicoma/kitchen/templates/kitchen/report/incorrect-units.html:8
msgid ""
"<b>Důvod:</b><br/> Níže uvedené zboží je zadáno s jinou jednotkou než je "
"aktuálně uloženo na skladu, například skořice je evidována v ks a v dokladu "
"v kg.<br/> Proto není možno spočítat celkovou cenu (jednotky není možno "
"převést).<br/> <br/> <b>Řešení:</b><br/> Oprav jednotku i množství uvedeného "
"zboží, nebo změn jednotku zboží na skladu.<br/>"
msgstr ""
"<b>Reason:</b><br/> The items listed below use a different unit than the one "
"currently stored in inventory. For example, cinnamon is recorded in pieces "
"(pcs) but a document uses kilograms (kg).<br/> Therefore, the total price "
"cannot be calculated because the units cannot be converted.<br/> <br/> "
"<b>Solution:</b><br/> Correct the unit and amount of the listed item, or "
"change the item's inventory unit.<br/>"

