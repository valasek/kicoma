#: kicoma/kitchen/templates/kitchen/docs.html:100
msgid "Inventura a reporty ukážou, co kolik stálo a co zbylo na skladu."
msgstr ""

#: kicoma/kitchen/templates/kitchen/docs.html:102
msgid "Menu aplikace i odkazy v příručce se řídí tvojí rolí."
msgstr ""

#: kicoma/kitchen/templates/kitchen/docs.html:107
msgid "Uživatele a jejich role spravuješ v"
